-static int set_valid_configuration(struct libusb_device* dev, struct usb_device *usbdev, struct libusb_device_handle *handle)
+/* Bus addresses already reported as left alone, since discovery checks a
+ * device again every second. Cleared when the device leaves. */
+static int no_mux_noted[32];
+static unsigned int no_mux_next;
+#define NO_MUX_SLOTS (sizeof(no_mux_noted) / sizeof(no_mux_noted[0]))
+
+static void note_no_active_mux(int bus, int address)
 {
-	int j, k, res, found = 0;
+	int key = (bus << 8) | address;
+	unsigned int i;
+	for (i = 0; i < NO_MUX_SLOTS; i++) {
+		if (no_mux_noted[i] == key)
+			return;
+	}
+	no_mux_noted[no_mux_next++ % NO_MUX_SLOTS] = key;
+	usbmuxd_log(LL_WARNING, "No usbmux interface in the active configuration of device %d-%d; leaving it alone", bus, address);
+}
+
+static void forget_no_active_mux(int bus, int address)
+{
+	int key = (bus << 8) | address;
+	unsigned int i;
+	for (i = 0; i < NO_MUX_SLOTS; i++) {
+		if (no_mux_noted[i] == key)
+			no_mux_noted[i] = 0;
+	}
+}
+
+static int has_mux_interface(const struct libusb_config_descriptor *config)
+{
+	int k;
+	for (k = 0; k < config->bNumInterfaces; k++) {
+		const struct libusb_interface_descriptor *intf = &config->interface[k].altsetting[0];
+		if (intf->bInterfaceClass == INTERFACE_CLASS &&
+		    intf->bInterfaceSubClass == INTERFACE_SUBCLASS &&
+		    intf->bInterfaceProtocol == INTERFACE_PROTOCOL)
+			return 1;
+	}
+	return 0;
+}
+
+/* Give an unconfigured device the configuration that carries its mux
+ * interface. The distro udev rule unconfigures these so a usbmuxd can choose,
+ * and with no configuration there are no drivers to disturb. */
+static void configure_mux(struct libusb_device *dev, struct libusb_device_handle *handle, int bus, int address)
+{
+	struct libusb_device_descriptor devdesc;
+	int j, res;
+	if (libusb_get_device_descriptor(dev, &devdesc) != 0)
+		return;
+	for (j = 0; j < devdesc.bNumConfigurations; j++) {
+		struct libusb_config_descriptor *config;
+		if (libusb_get_config_descriptor(dev, j, &config) != 0)
+			continue;
+		int value = config->bConfigurationValue;
+		int mux = has_mux_interface(config);
+		libusb_free_config_descriptor(config);
+		if (!mux)
+			continue;
+		usbmuxd_log(LL_NOTICE, "Configuring unconfigured device %d-%d: %d", bus, address, value);
+		if ((res = libusb_set_configuration(handle, value)) != 0)
+			usbmuxd_log(LL_WARNING, "Could not set configuration %d for device %d-%d: %s", value, bus, address, libusb_error_name(res));
+		return;
+	}
+}
