+/* The link to the KIS device bound to WinUSB at path, opening it when this
+ * process has none. A WinUSB device opens once, so one another process has
+ * open is tried attempts times. */
+static struct kis_link* kis_link_get_path(const char *path, int attempts, int enable)
+{
+	HANDLE file = INVALID_HANDLE_VALUE;
+	WINUSB_INTERFACE_HANDLE winusb = NULL;
+	struct kis_link *link = NULL;
+	int attempt;
+
+	for (attempt = 0; ; attempt++) {
+		link = kis_link_find_path(path);
+		if (link) {
+			break;
+		}
+		file = CreateFileA(path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, FILE_FLAG_OVERLAPPED, NULL);
+		if (file != INVALID_HANDLE_VALUE) {
+			break;
+		}
+		DWORD err = GetLastError();
+		if (err != ERROR_ACCESS_DENIED || attempt + 1 >= attempts) {
+			debug("%s: can't open %s: %lu\n", __func__, path, err);
+			return NULL;
+		}
+		kis_sleep_ms(KIS_OPEN_RETRY_MS);
+	}
+	if (!link) {
+		if (!WinUsb_Initialize(file, &winusb)) {
+			debug("%s: WinUsb_Initialize failed: %lu\n", __func__, GetLastError());
+			CloseHandle(file);
+			return NULL;
+		}
+		link = kis_link_new(0);
+		if (!link) {
+			WinUsb_Free(winusb);
+			CloseHandle(file);
+			return NULL;
+		}
+		link->file = file;
+		link->winusb = winusb;
+		link->path = strdup(path);
+		if (!link->path) {
+			kis_link_free(link);
+			return NULL;
+		}
+		WINUSB_PIPE_INFORMATION pipe;
+		if (WinUsb_QueryPipe(winusb, 0, 0, &pipe) && pipe.MaximumPacketSize) {
+			link->packet = pipe.MaximumPacketSize;
+		}
+		struct kis_link *other = NULL;
+		mutex_lock(&kis_links_mutex);
+		FOREACH(struct kis_link *l, &kis_links) {
+			if (!l->dead && l->path && _stricmp(l->path, path) == 0) {
+				l->refs++;
+				other = l;
+				break;
+			}
+		} ENDFOREACH
+		if (!other) {
+			collection_add(&kis_links, link);
+		}
+		mutex_unlock(&kis_links_mutex);
+		if (other) {
+			kis_link_free(link);
+			link = other;
+		} else {
+			debug("%s: opened %s\n", __func__, path);
+		}
+	}
+	if (enable && kis_link_enable(link) != IRECV_E_SUCCESS) {
+		debug("%s: failed to enable the KIS device\n", __func__);
+		kis_link_put(link);
+		return NULL;
+	}
+	return link;
+}
