+#ifdef HAVE_IOKIT
+/*
+ * macOS only lets processes holding com.apple.private.debug-usb.access open a
+ * Debug USB (KIS) device, and only Apple's deviceinterfaced has it. The daemon
+ * does expose a generic KIS transport to any client through
+ * DeviceInterfaceClient.framework, so route KIS requests through that instead
+ * of opening the device ourselves. The framework is private, so it's loaded at
+ * runtime and every failure falls back to the plain IOKit path.
+ */
+#define DIC_FRAMEWORK "/Library/Apple/System/Library/PrivateFrameworks/DeviceInterfaceClient.framework/DeviceInterfaceClient"
+#define DIC_MAX_SCALARS 16
+
+static struct {
+	void *client;
+	bool (*list_devices)(void *client, uint64_t *ids, size_t *count);
+	bool (*transfer_data)(void *client, uint64_t id, const uint64_t *scalars, uint32_t scalar_count, const void *in, size_t in_size, void *out, size_t *out_size);
+} dic;
+static pthread_once_t dic_once = PTHREAD_ONCE_INIT;
+static uint32_t dic_sequence;
+
+static void dic_load_once(void)
+{
+	if (getenv("IRECV_KIS_NO_DIC")) {
+		return;
+	}
+	void *h = dlopen(DIC_FRAMEWORK, RTLD_NOW | RTLD_LOCAL);
+	if (!h) {
+		debug("%s: DeviceInterfaceClient unavailable: %s\n", __func__, dlerror());
+		return;
+	}
+	void *(*create)(dispatch_queue_t) = dlsym(h, "device_interface_client_server_xpc_client_create");
+	dic.list_devices = dlsym(h, "device_interface_client_server_xpc_client_list_devices");
+	dic.transfer_data = dlsym(h, "device_interface_client_server_xpc_client_transfer_data");
+	if (!create || !dic.list_devices || !dic.transfer_data) {
+		debug("%s: DeviceInterfaceClient is missing expected symbols\n", __func__);
+		return;
+	}
+	dic.client = create(dispatch_queue_create("libirecovery.kis", DISPATCH_QUEUE_SERIAL));
+	if (!dic.client) {
+		debug("%s: could not connect to deviceinterfaced\n", __func__);
+	}
 }
 
+static int dic_available(void)
+{
+	pthread_once(&dic_once, dic_load_once);
+	return dic.client != NULL;
+}
+
+static uint16_t iokit_registry_pid(io_service_t service)
+{
+	uint16_t pid = 0;
+	CFNumberRef num = (CFNumberRef)IORegistryEntryCreateCFProperty(service, CFSTR(kUSBProductID), kCFAllocatorDefault, 0);
+	if (num) {
+		CFNumberGetValue(num, kCFNumberSInt16Type, &pid);
+		CFRelease(num);
+	}
+	return pid;
+}
+
+/* deviceinterfaced names interfaces by an opaque 64-bit id. Match it against
+ * the registry entry ids of the device and its interfaces; failing that, a lone
+ * interface can only be this device. */
+static uint64_t dic_find_interface(io_service_t service)
+{
+	uint64_t ids[16];
+	size_t count = sizeof(ids) / sizeof(ids[0]);
+	if (!dic.list_devices(dic.client, ids, &count) || count == 0) {
+		debug("%s: deviceinterfaced lists no KIS interfaces\n", __func__);
+		return 0;
+	}
+	if (count > sizeof(ids) / sizeof(ids[0])) {
+		count = sizeof(ids) / sizeof(ids[0]);
+	}
+
+	uint64_t entry = 0;
+	if (IORegistryEntryGetRegistryEntryID(service, &entry) == KERN_SUCCESS) {
+		for (size_t i = 0; i < count; i++) {
+			if (ids[i] == entry) {
+				return ids[i];
+			}
+		}
+	}
+	io_iterator_t children = IO_OBJECT_NULL;
+	if (IORegistryEntryGetChildIterator(service, kIOServicePlane, &children) == KERN_SUCCESS) {
+		io_registry_entry_t child;
+		uint64_t found = 0;
+		while (!found && (child = IOIteratorNext(children))) {
+			if (IORegistryEntryGetRegistryEntryID(child, &entry) == KERN_SUCCESS) {
+				for (size_t i = 0; i < count; i++) {
+					if (ids[i] == entry) {
+						found = ids[i];
+						break;
+					}
+				}
+			}
+			IOObjectRelease(child);
+		}
+		IOObjectRelease(children);
+		if (found) {
+			return found;
+		}
+	}
+	if (count == 1) {
+		return ids[0];
+	}
+	debug("%s: %zu KIS interfaces and none match this device\n", __func__, count);
+	return 0;
+}
+
+/* Takes ownership of `service`, like iokit_usb_open_service. */
+static irecv_error_t dic_open_service(irecv_client_t *pclient, io_service_t service)
+{
+	uint64_t id = dic_find_interface(service);
+	IOObjectRelease(service);
+	if (!id) {
+		return IRECV_E_UNABLE_TO_CONNECT;
+	}
+	irecv_client_t client = (irecv_client_t)calloc(1, sizeof(struct irecv_client_private));
+	if (!client) {
+		return IRECV_E_OUT_OF_MEMORY;
+	}
+	client->mode = KIS_PRODUCT_ID;
+	client->kis_dic = 1;
+	client->kis_dic_id = id;
+	debug("opening KIS device via deviceinterfaced (interface %#" PRIx64 ")...\n", id);
+	*pclient = client;
+	return IRECV_E_SUCCESS;
+}
