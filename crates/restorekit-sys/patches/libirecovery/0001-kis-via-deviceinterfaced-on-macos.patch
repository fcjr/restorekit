+static irecv_error_t dic_kis_request(irecv_client_t client, KIS_req_header *req, size_t reqSize, KIS_req_header *rpl, size_t *rplSize)
+{
+	if (reqSize < sizeof(KIS_req_header)) {
+		return IRECV_E_INVALID_INPUT;
+	}
+
+	/* The daemon matches replies to requests by their first header word and
+	 * uses 0xFFxx sequence numbers for its own requests. Stay in 1..0x7FFF;
+	 * restorekit's own identity reads use 0x8000 and up. */
+	req->sequence = (uint16_t)(__atomic_add_fetch(&dic_sequence, 1, __ATOMIC_RELAXED) % 0x7FFF + 1);
+
+	/* The daemon writes scalars[1..] out as little-endian 32-bit words followed
+	 * by the input bytes, so the header and arguments go in as scalars and any
+	 * payload as input. scalars[0] is the timeout in milliseconds. */
+	const uint8_t *bytes = (const uint8_t *)req;
+	size_t words = 3 + req->argCount;
+	if (words > DIC_MAX_SCALARS - 1) {
+		words = DIC_MAX_SCALARS - 1;
+	}
+	if (words * 4 > reqSize) {
+		words = reqSize / 4;
+	}
+	uint64_t scalars[DIC_MAX_SCALARS];
+	scalars[0] = USB_TIMEOUT;
+	for (size_t i = 0; i < words; i++) {
+		uint32_t w;
+		memcpy(&w, bytes + i * 4, 4);
+		scalars[1 + i] = w;
+	}
+	const void *in = (reqSize > words * 4) ? bytes + words * 4 : NULL;
+	size_t in_size = reqSize - words * 4;
+
+	size_t out_size = *rplSize;
+	if (!dic.transfer_data(dic.client, client->kis_dic_id, scalars, (uint32_t)(1 + words), in, in_size, rpl, &out_size)) {
+		debug("%s: deviceinterfaced transfer failed (portal %#x)\n", __func__, req->portal);
+		return IRECV_E_USB_UPLOAD;
+	}
+	*rplSize = out_size;
+	return IRECV_E_SUCCESS;
+}
