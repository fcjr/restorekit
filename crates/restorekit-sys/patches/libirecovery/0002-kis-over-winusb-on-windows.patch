+/*
+ * KIS over WinUSB. The KIS code above talks to Apple's AppleKIS driver, which
+ * does the KIS framing itself behind its own ioctls and shows up as
+ * "\\?\kis#vid_05ac&pid_0001". With plain WinUSB bound to 05ac:1881 instead
+ * (as restorekit does), the device shows up as a regular "\\?\usb#" interface
+ * and has to be spoken to the way the libusb and IOKit backends do: raw KIS
+ * requests on the bulk pipes (CONFIG portal on 0x01/0x81, RSM on 0x03/0x83).
+ * Requests are built as bytes so the layout doesn't depend on the AppleKIS
+ * structs defined for Windows.
+ */
+#define KISW_HEADER_SIZE 12
+#define KISW_INFO_SIZE   0x300
+#define KISW_TRAILER     8
+#define KISW_CHUNK       0x4000
+
+static int kisw_open(irecv_client_t client)
+{
+	if (!WinUsb_Initialize(client->handle, &client->kis_winusb)) {
+		debug("%s: WinUsb_Initialize failed: %d\n", __func__, (int)GetLastError());
+		client->kis_winusb = NULL;
+		return 0;
+	}
+	ULONG timeout = USB_TIMEOUT;
+	UCHAR pipes[] = { 0x01, 0x81, 0x03, 0x83 };
+	for (size_t i = 0; i < sizeof(pipes); i++) {
+		WinUsb_SetPipePolicy(client->kis_winusb, pipes[i], PIPE_TRANSFER_TIMEOUT, sizeof(timeout), &timeout);
+	}
+	return 1;
+}
+
+static void kisw_put32(uint8_t *p, uint32_t v)
+{
+	p[0] = v & 0xff;
+	p[1] = (v >> 8) & 0xff;
+	p[2] = (v >> 16) & 0xff;
+	p[3] = (v >> 24) & 0xff;
+}
+
+static uint32_t kisw_get32(const uint8_t *p)
+{
+	return p[0] | (p[1] << 8) | (p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* Same layout as irecv_kis_request_init. */
+static void kisw_header(uint8_t *h, uint8_t portal, uint16_t index, size_t arg_count, size_t payload_size, size_t rpl_words)
+{
+	h[0] = 0;
+	h[1] = 0;
+	h[2] = 0xA0;
+	h[3] = portal;
+	h[4] = (uint8_t)arg_count;
+	h[5] = (uint8_t)(index & 0xFF);
+	h[6] = (uint8_t)(((index >> 8) & 0x3) | ((rpl_words << 2) & 0xFC));
+	h[7] = (uint8_t)((rpl_words >> 6) & 0xFF);
+	kisw_put32(h + 8, (uint32_t)(payload_size + (arg_count << 2)));
+}
+
+static irecv_error_t kisw_request(irecv_client_t client, const uint8_t *req, size_t req_size, uint8_t *rpl, size_t *rpl_size)
+{
+	UCHAR pipe;
+	switch (req[3]) {
+		case KIS_PORTAL_CONFIG:
+			pipe = 0x01;
+			break;
+		case KIS_PORTAL_RSM:
+			pipe = 0x03;
+			break;
+		default:
+			return IRECV_E_INVALID_INPUT;
+	}
+	ULONG sent = 0;
+	if (!WinUsb_WritePipe(client->kis_winusb, pipe, (PUCHAR)req, (ULONG)req_size, &sent, NULL) || sent != req_size) {
+		debug("%s: WinUsb_WritePipe(%#x) failed: %d\n", __func__, pipe, (int)GetLastError());
+		return IRECV_E_USB_UPLOAD;
+	}
+	ULONG rcvd = 0;
+	if (!WinUsb_ReadPipe(client->kis_winusb, pipe | 0x80, rpl, (ULONG)*rpl_size, &rcvd, NULL)) {
+		debug("%s: WinUsb_ReadPipe(%#x) failed: %d\n", __func__, pipe | 0x80, (int)GetLastError());
+		return IRECV_E_USB_UPLOAD;
+	}
+	*rpl_size = rcvd;
+	return IRECV_E_SUCCESS;
 }
+
+static irecv_error_t kisw_write32(irecv_client_t client, uint8_t portal, uint16_t index, uint32_t value)
+{
+	uint8_t req[KISW_HEADER_SIZE + 4];
+	uint8_t rpl[KISW_HEADER_SIZE + KISW_TRAILER];
+	size_t rpl_size = sizeof(rpl);
+	kisw_header(req, portal, index, 1, 0, 1);
+	kisw_put32(req + KISW_HEADER_SIZE, value);
+	return kisw_request(client, req, sizeof(req), rpl, &rpl_size);
+}
+
+static irecv_error_t kisw_init(irecv_client_t client)
+{
+	irecv_error_t err = kisw_write32(client, KIS_PORTAL_CONFIG, KIS_INDEX_ENABLE_A, KIS_ENABLE_A_VAL);
+	if (err == IRECV_E_SUCCESS) {
+		err = kisw_write32(client, KIS_PORTAL_CONFIG, KIS_INDEX_ENABLE_B, KIS_ENABLE_B_VAL);
+	}
+	if (err != IRECV_E_SUCCESS) {
+		debug("%s: failed to enable KIS device, error %d\n", __func__, err);
+		return err;
+	}
+	client->isKIS = 1;
+	return IRECV_E_SUCCESS;
+}
+
+/* A USB string descriptor at word offset `word` of the info block, as ASCII. */
+static int kisw_read_string(const uint8_t *info, uint32_t word, char *buf, size_t buf_size)
+{
+	size_t off = (size_t)word * 4;
+	if (off + 2 > KISW_INFO_SIZE) {
+		return 0;
+	}
+	uint8_t len = info[off];
+	if ((len & 1) || info[off + 1] != 3 || len / 2 >= buf_size || off + 2 + len > KISW_INFO_SIZE) {
+		return 0;
+	}
+	for (size_t i = 0; i < len; i += 2) {
+		buf[i / 2] = info[off + 2 + i];
+	}
+	buf[len / 2] = 0;
+	return len / 2;
+}
+
+static irecv_error_t kisw_load_device_info(irecv_client_t client)
+{
+	uint8_t req[KISW_HEADER_SIZE];
+	uint8_t rpl[KISW_HEADER_SIZE + KISW_INFO_SIZE + KISW_TRAILER];
+	size_t rpl_size = sizeof(rpl);
+	kisw_header(req, KIS_PORTAL_RSM, KIS_INDEX_GET_INFO, 0, 0, KISW_INFO_SIZE / 4);
+	irecv_error_t err = kisw_request(client, req, sizeof(req), rpl, &rpl_size);
+	if (err != IRECV_E_SUCCESS) {
+		return err;
+	}
+	if (rpl_size < KISW_HEADER_SIZE + KISW_INFO_SIZE) {
+		debug("%s: short GET_INFO reply (%u bytes), not in DFU?\n", __func__, (unsigned)rpl_size);
+		return IRECV_E_INVALID_INPUT;
+	}
+	const uint8_t *info = rpl + KISW_HEADER_SIZE;
+	/* The embedded USB device descriptor starts at 64; iSerialNumber is at +16
+	 * and idProduct at +10. The nonce string's word offset is at 24. */
+	char buf[0x100];
+	if (!kisw_read_string(info, info[64 + 16], buf, sizeof(buf))) {
+		return IRECV_E_INVALID_INPUT;
+	}
+	debug("Serial: %s\n", buf);
+	irecv_load_device_info_from_iboot_string(client, buf);
+	if (kisw_read_string(info, kisw_get32(info + 24), buf, sizeof(buf))) {
+		debug("Nonces: %s\n", buf);
+		irecv_copy_nonce_with_tag_from_buffer("NONC", &client->device_info.ap_nonce, &client->device_info.ap_nonce_size, buf);
+		irecv_copy_nonce_with_tag_from_buffer("SNON", &client->device_info.sep_nonce, &client->device_info.sep_nonce_size, buf);
+	}
+	client->mode = info[64 + 10] | (info[64 + 11] << 8);
+	return IRECV_E_SUCCESS;
+}
+
+static irecv_error_t kisw_send_buffer(irecv_client_t client, unsigned char* buffer, unsigned long length, unsigned int options)
+{
+	unsigned long orig_len = length;
+	uint64_t address = 0;
+	uint8_t *req = malloc(KISW_HEADER_SIZE + 12 + KISW_CHUNK);
+	if (!req) {
+		return IRECV_E_OUT_OF_MEMORY;
+	}
+	while (length) {
+		size_t chunk = length > KISW_CHUNK ? KISW_CHUNK : length;
+		/* UPLOAD: args are the 64-bit address and the 32-bit size. */
+		kisw_header(req, KIS_PORTAL_RSM, KIS_INDEX_UPLOAD, 3, chunk, 0);
+		kisw_put32(req + KISW_HEADER_SIZE, (uint32_t)(address & 0xffffffff));
+		kisw_put32(req + KISW_HEADER_SIZE + 4, (uint32_t)(address >> 32));
+		kisw_put32(req + KISW_HEADER_SIZE + 8, (uint32_t)chunk);
+		memcpy(req + KISW_HEADER_SIZE + 12, buffer, chunk);
+
+		uint8_t rpl[KISW_HEADER_SIZE + KISW_TRAILER];
+		size_t rpl_size = sizeof(rpl);
+		irecv_error_t err = kisw_request(client, req, KISW_HEADER_SIZE + 12 + chunk, rpl, &rpl_size);
+		if (err != IRECV_E_SUCCESS) {
+			free(req);
+			debug("Failed to upload chunk, error %d\n", err);
+			return err;
+		}
+		address += chunk;
+		buffer += chunk;
+		length -= chunk;
+
+		if (client->progress_callback != NULL) {
+			irecv_event_t event;
+			event.progress = ((double)(orig_len - length) / (double)orig_len) * 100.0;
+			event.type = IRECV_PROGRESS;
+			event.data = (char*)"Uploading";
+			event.size = orig_len - length;
+			client->progress_callback(client, &event);
+		}
+	}
+	free(req);
+
+	if (options & IRECV_SEND_OPT_DFU_NOTIFY_FINISH) {
+		irecv_error_t err = kisw_write32(client, KIS_PORTAL_RSM, KIS_INDEX_BOOT_IMG, (uint32_t)orig_len);
+		if (err != IRECV_E_SUCCESS) {
+			debug("Failed to boot image, error %d\n", err);
+			return err;
+		}
+	}
+	return IRECV_E_SUCCESS;
+}
