+/* The one KIS device this process may open, by locationID; 0 for any. */
+static uint32_t kis_location;
+
+static uint32_t iokit_location(io_service_t service)
+{
+	uint32_t location = 0;
+	CFNumberRef num = (CFNumberRef)IORegistryEntryCreateCFProperty(service, CFSTR(kUSBDevicePropertyLocationID), kCFAllocatorDefault, 0);
+	if (num) {
+		CFNumberGetValue(num, kCFNumberSInt32Type, &location);
+		CFRelease(num);
+	}
+	return location;
+}
+
+/* Reading a KIS device's ECID means opening it and sending it requests, which
+ * would reach another process's Mac in the middle of its own transfers. */
+static int iokit_kis_excluded(io_service_t service)
+{
+	uint32_t location = __atomic_load_n(&kis_location, __ATOMIC_RELAXED);
+	return location != 0 && iokit_location(service) != location;
+}
+
 /* deviceinterfaced names interfaces by an opaque 64-bit id. Match it against
  * the registry entry ids of the device and its interfaces. */
