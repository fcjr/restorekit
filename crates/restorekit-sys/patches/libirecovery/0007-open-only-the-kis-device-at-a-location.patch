+/* Open and probe only the KIS (Apple Debug USB) device at this USB location,
+ * its IOKit locationID; other KIS devices are passed over unopened, so a
+ * process never sends requests to a Mac another process is restoring. 0 clears
+ * it. Returns IRECV_E_UNSUPPORTED where KIS devices aren't found through IOKit. */
+IRECV_API irecv_error_t irecv_set_kis_location(uint32_t location);
 IRECV_API const char* irecv_strerror(irecv_error_t error);
 
