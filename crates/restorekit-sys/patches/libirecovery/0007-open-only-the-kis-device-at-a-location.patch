+irecv_error_t irecv_set_kis_location(uint32_t location)
+{
+#if !defined(USE_DUMMY) && !defined(_WIN32) && defined(HAVE_IOKIT)
+	__atomic_store_n(&kis_location, location, __ATOMIC_RELAXED);
