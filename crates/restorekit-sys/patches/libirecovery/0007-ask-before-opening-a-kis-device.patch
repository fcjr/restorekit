 /* library */
 IRECV_API void irecv_set_debug_level(int level);
+/* Asked before a KIS (Apple Debug USB) device is opened or probed, with its USB
+ * location (its IOKit locationID): a nonzero answer passes over the device
+ * unopened, so a process can keep off a Mac another process is restoring.
+ * Called from the device event thread too. NULL clears it. Returns
+ * IRECV_E_UNSUPPORTED where KIS devices aren't found through IOKit. */
+typedef int (*irecv_kis_filter_t)(uint32_t location);
+IRECV_API irecv_error_t irecv_set_kis_filter(irecv_kis_filter_t filter);
 IRECV_API const char* irecv_strerror(irecv_error_t error);
 
 IRECV_API const char* irecv_version();
--- a/src/libirecovery.c
+++ b/src/libirecovery.c
@@ -2194,6 +2194,28 @@
 		CFRelease(num);
 	}
 	return pid;
+}
+
+/* Asked before a KIS device is opened; see irecv_set_kis_filter(). */
+static irecv_kis_filter_t kis_filter;
+
+static uint32_t iokit_location(io_service_t service)
+{
+	uint32_t location = 0;
+	CFNumberRef num = (CFNumberRef)IORegistryEntryCreateCFProperty(service, CFSTR(kUSBDevicePropertyLocationID), kCFAllocatorDefault, 0);
+	if (num) {
+		CFNumberGetValue(num, kCFNumberSInt32Type, &location);
+		CFRelease(num);
+	}
+	return location;
+}
+
+/* Reading a KIS device's ECID means opening it and sending it requests, which
+ * would reach another process's Mac in the middle of its own transfers. */
+static int iokit_kis_excluded(io_service_t service)
+{
+	irecv_kis_filter_t filter = __atomic_load_n(&kis_filter, __ATOMIC_RELAXED);
+	return filter && filter(iokit_location(service));
 }
 
